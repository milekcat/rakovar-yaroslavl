# Local preview only. Never commit real credentials.
DEMO_MODE=true
PORT=8080
COOKIE_SECURE=false
FLASK_SECRET_KEY=replace-with-a-long-random-value
ADMIN_PASSWORD_HASH=
SQLITE_DB_PATH=./instance/rakovar-preview.sqlite3
# Optional PostgreSQL. When set, SQLite is never used as a fallback.
# Store the actual URL in the deployment secret store, never in Git.
DATABASE_URL=
# Enroll and verify owner MFA privately before changing this to true.
STAFF_REQUIRE_MFA=false

# Optional MAX integration. Keep token private.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_MINIAPP_URL=
MAX_ADMIN_USER_ID=
MAX_WEBHOOK_SECRET=
MAX_BOT_MODE=polling

LOYALTY_RUB_PER_TICKET=1000
PREVIEW_DELIVERY_RUB=200
PREVIEW_DELIVERY_MIN_RUB=1000

# Separate stable random encryption secret, generated by Render for hosted deployments.
INTEGRATION_ENCRYPTION_KEY=
# Legacy /admin/login returns 404 to unauthenticated visitors; use the separate team entry.
HIDE_STAFF_ENTRY=true
